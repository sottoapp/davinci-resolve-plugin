{
  "description": "Source-media safety and frame-evidence guards for DaVinci Resolve work.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*davinci-resolve__(timeline_item_color|color_group)",
        "hooks": [{ "type": "command", "command": "DAVINCI_AGENT_HOST=claude python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/frame_verification_guard.py\"", "timeout": 15 }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "DAVINCI_AGENT_HOST=claude python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/source_media_guard.py\"", "timeout": 15 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*davinci-resolve__(media_analysis|gallery|gallery_stills|timeline_item_color)|Read|Bash",
        "hooks": [{ "type": "command", "command": "DAVINCI_AGENT_HOST=claude python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/frame_verification_guard.py\"", "timeout": 15 }]
      }
    ]
  }
}
